{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SARPRAS ALKES",
  "version": "0.1.0",
  "identifier": "id.go.rsudkendari.sarpras",
  "build": {
    "frontendDist": "../../web-spa/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../web-spa run dev",
    "beforeBuildCommand": "npm --prefix ../web-spa run build"
  },
  "app": {
    "windows": [
      {
        "title": "SARPRAS & ALKES — RSUD Kota Kendari",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
