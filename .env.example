# --- Contoh konfigurasi environment (copy ke .env) ---
# Database (PostgreSQL 16 native, tanpa Docker)
DATABASE_URL=postgres://sarpras:sarpras_dev_pw@localhost:5432/sarpras_dev
TEST_DATABASE_URL=postgres://sarpras:sarpras_dev_pw@localhost:5432/sarpras_test

# Keamanan
# WARNING: ganti nilai ini untuk produksi (openssl rand -hex 32)
JWT_SECRET=dev-only-secret-ganti-sebelum-produksi-0123456789

# Server
BIND_ADDR=127.0.0.1:8080

# File storage lokal
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10

# Admin awal (seed) — wajib ganti password setelah login pertama
ADMIN_INITIAL_PASSWORD=admin123
